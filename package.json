{
  "name": "vintagejs",
  "description": "Add a retro/vintage effect to images using the HTML5 canvas element",
  "license": "MIT",
  "version": "2.3.0",
  "author": {
    "name": "Robert Fleischmann",
    "email": "rendro87@gmail.com",
    "url": "https://robert-fleischmann.com"
  },
  "main": "./dist/vintage.js",
  "module": "./dist/vintage.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vintage.mjs",
      "require": "./dist/vintage.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && vite build --mode min && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "nullthrows": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
